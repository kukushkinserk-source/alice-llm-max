# Задавать в Timeweb App Platform → переменные окружения.
# НИКОГДА не публиковать реальный API_KEY или ALICE_WEBHOOK_SECRET в GitHub.
API_KEY=
BASE_URL=https://api.timeweb.ai/v1
# Уточни точный ID в панели Timeweb → AI Gateway → Подключение.
MODEL=deepseek/deepseek-v4.1-flash
# Не добавляй REASONING_EFFORT, если модель его не поддерживает.
REASONING_EFFORT=
# 24+ случайных символов. URL вебхука: https://<адрес-приложения>/hook/<секрет>
ALICE_WEBHOOK_SECRET=
# Добавим после тестирования навыка в Яндекс Диалогах.
ALICE_SKILL_ID=
# SYSTEM_PROMPT=Твой вариант системной инструкции одной строкой.
